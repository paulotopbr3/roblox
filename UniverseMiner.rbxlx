      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Commerce</string>
          <string name="Source"><![CDATA[local Marketplace = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local C = require(game.ReplicatedStorage.UniverseMiner.Config)
local Economy = require(game.ReplicatedStorage.UniverseMiner.Economy)
local Data = require(script.Parent.Data)
local Game = require(script.Parent.Game)
local Commerce = {}
local products = {}
local passIds = {}
for key, product in pairs(C.Products) do
	if product.Id > 0 then
		assert(not products[product.Id], "Developer Product ID duplicado")
		products[product.Id] = product
	end
end
for key, id in pairs(C.Passes) do
	if id > 0 then
		assert(not passIds[id], "Gamepass ID duplicado")
		passIds[id] = key
	end
end
function Commerce.refresh(player)
	local s = Data.Sessions[player]
	if not s then
		return
	end
	for key, id in pairs(C.Passes) do
		if id > 0 then
			local ok, owned = pcall(function()
				return Marketplace:UserOwnsGamePassAsync(player.UserId, id)
			end)
			if ok and Data.Sessions[player] == s then
				s.Data.Passes[key] = owned
			else
				warn("Gamepass não verificado:", key)
			end
		end
	end
	if Data.Sessions[player] ~= s or s.Closing then
		return
	end
	if s.Data.Passes.ExclusivePets and not s.Data.ExclusiveGranted then
		Game.pet(s.Data, "vip")
		s.Data.ExclusiveGranted = true
	end
	Game.snapshot(player)
end
function Commerce.prompt(player, arg)
	if type(arg) ~= "table" or type(arg.Key) ~= "string" then
		return
	end
	if arg.Type == "Pass" then
		local id = C.Passes[arg.Key]
		if id and id > 0 then
			Marketplace:PromptGamePassPurchase(player, id)
		else
			Game.notice(player, "Gamepass ainda não configurado.")
		end
	elseif arg.Type == "Product" then
		local p = C.Products[arg.Key]
		if p and p.Id > 0 then
			Marketplace:PromptProductPurchase(player, p.Id)
		else
			Game.notice(player, "Produto ainda não configurado.")
		end
	end
end
function Commerce.init()
	Marketplace.PromptGamePassPurchaseFinished:Connect(function(player, _, purchased)
		if purchased then
			task.spawn(Commerce.refresh, player)
		end
	end)
	Marketplace.ProcessReceipt = function(receipt)
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		local s = player and Data.Sessions[player]
		if not s or not Data.writable(player) or s.Temporary then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local product = products[receipt.ProductId]
		if not product then
			warn("Recibo de produto sem configuração:", receipt.ProductId)
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local d = s.Data
		local receiptKey = tostring(receipt.PurchaseId)
		-- Grant without yielding; record in the SAME durable profile. Retry always saves
		-- before acknowledgement, including an earlier in-memory grant whose save failed.
		local valid = Economy.receipt(d, receiptKey, product, os.time(), Game.pet, C.MaxNumber)
		if not valid then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		if not Data.save(player, false) then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		Game.snapshot(player)
		Game.notice(player, "Compra entregue e salva!")
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
end
return Commerce
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Data</string>
          <string name="Source"><![CDATA[local DSS = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local Http = game:GetService("HttpService")
local C = require(game.ReplicatedStorage.UniverseMiner.Config)
local Data = { Sessions = {} }
local store = DSS:GetDataStore(C.DataStore)
local token = game.JobId .. ":" .. Http:GenerateGUID(false)
local LEASE = 240
local function copy(value)
	if type(value) ~= "table" then
		return value
	end
	local out = {}
	for k, v in pairs(value) do
		out[k] = copy(v)
	end
	return out
end
local function fresh()
	return {
		Version = 1,
		Coins = 0,
		Gems = 0,
		Rebirths = 0,
		Tool = 1,
		World = 1,
		Unlocked = { ["1"] = true },
		Pets = {},
		Equipped = {},
		Passes = {},
		Settings = { Music = true, Effects = true },
		Boosts = { Coins = 0, Luck = 0 },
		Bag = 0,
		BagCount = 0,
		ExclusiveGranted = false,
		EggCredits = 0,
		Crystals = 0,
		TotalCoins = 0,
		TotalPets = 0,
		Codes = {},
		Receipts = {},
		Daily = { Day = math.floor(os.time() / 86400), Crystals = 0, Coins = 0, Eggs = 0, Claimed = {} },
	}
end
local function normalize(raw)
	local d = fresh()
	if type(raw) ~= "table" then
		return d
	end
	if raw.Version and raw.Version ~= 1 then
		error("Versão de dados não suportada")
	end
	for k, v in pairs(d) do
		if type(raw[k]) == type(v) then
			d[k] = raw[k]
		end
	end
	for _, key in ipairs({ "Coins", "Gems", "Rebirths", "Bag", "BagCount", "EggCredits", "Crystals", "TotalCoins", "TotalPets" }) do
		local n = d[key]
		d[key] = (n == n and n >= 0 and n < math.huge) and math.min(C.MaxNumber, n) or 0
	end
	d.Tool = math.clamp(math.floor(tonumber(d.Tool) or 1), 1, #C.Tools)
	d.World = math.clamp(math.floor(tonumber(d.World) or 1), 1, #C.Worlds)
	d.Unlocked["1"] = true
	local pets = {}
	for _, pet in ipairs(d.Pets) do
		if type(pet) == "table" and type(pet.Uid) == "string" and C.Pets[pet.Id] then
			table.insert(pets, pet)
		end
	end
	d.Pets = pets
	d.Passes = {} -- Ownership is verified with Marketplace on each login.
	return d
end
function Data.load(player)
	local loaded, blocked
	local ok, err = pcall(function()
		store:UpdateAsync("u:" .. player.UserId, function(old)
			blocked = false
			if old and old.Lock and old.Lock.Token ~= token and (old.Lock.Expires or 0) > os.time() then
				blocked = true
				return nil
			end
			loaded = normalize(old and old.Data)
			return { Data = loaded, Lock = { Token = token, Expires = os.time() + LEASE } }
		end)
	end)
	if blocked then
		return nil, "Seus dados estão em outra sessão. Aguarde um minuto e tente novamente."
	end
	if not ok then
		warn("UniverseMiner load:", err)
		if RunService:IsStudio() and C.StudioTemporaryData then
			local s = { Data = fresh(), Temporary = true, Busy = false, LastSave = os.time() }
			Data.Sessions[player] = s
			return s
		end
		return nil, "Não foi possível carregar seus dados com segurança. Tente novamente."
	end
	local s = { Data = loaded, Temporary = false, Busy = false, LastSave = os.time() }
	Data.Sessions[player] = s
	return s
end
function Data.save(player, release)
	local s = Data.Sessions[player]
	if not s then
		return false
	end
	while s.Busy do
		task.wait(0.1)
	end
	if s.Temporary then
		return true
	end
	s.Busy = true
	local snapshot = copy(s.Data)
	local lost = false
	local ok, err = pcall(function()
		store:UpdateAsync("u:" .. player.UserId, function(old)
			if not old or not old.Lock or old.Lock.Token ~= token then
				lost = true
				return nil
			end
			return { Data = snapshot, Lock = not release and { Token = token, Expires = os.time() + LEASE } or nil }
		end)
	end)
	s.Busy = false
	if lost then
		s.ReadOnly = true
		player:Kick("A sessão de dados expirou. Entre novamente para proteger seu progresso.")
	end
	if not ok then
		warn("UniverseMiner save:", err)
	end
	if ok and not lost then
		s.LastSave = os.time()
		return true
	end
	return false
end
function Data.release(player)
	local s = Data.Sessions[player]
	if not s then
		return
	end
	s.Closing = true
	for attempt = 1, 3 do
		if Data.save(player, true) then
			break
		end
		task.wait(attempt)
	end
	Data.Sessions[player] = nil
end
function Data.writable(player)
	local s = Data.Sessions[player]
	return s and not s.ReadOnly and not s.Closing and (s.Temporary or os.time() - s.LastSave < LEASE - 40)
end
return Data
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Game</string>
          <string name="Source"><![CDATA[local Http = game:GetService("HttpService")
local Messaging = game:GetService("MessagingService")
local C = require(game.ReplicatedStorage.UniverseMiner.Config)
local B = require(game.ReplicatedStorage.UniverseMiner.Balance)
local Economy = require(game.ReplicatedStorage.UniverseMiner.Economy)
local Data = require(script.Parent.Data)
local Map = require(script.Parent.Map)
local Game = { Runtime = {} }
local rng = Random.new()
local outbound
function Game.init(remote)
	outbound = remote
end
function Game.emit(player, kind, payload)
	outbound:FireClient(player, kind, payload)
end
function Game.notice(player, text)
	Game.emit(player, "Notice", text)
end
function Game.event()
	local now = os.time()
	local cycle = math.floor(now / C.EventPeriod)
	local elapsed = now % C.EventPeriod
	local names = { "Coins", "Luck", "Gems", "Exclusive" }
	return {
		Kind = names[cycle % 4 + 1],
		Active = elapsed < C.EventDuration,
		Ends = cycle * C.EventPeriod + C.EventDuration,
		Next = (cycle + 1) * C.EventPeriod,
	}
end
local function clamp(n)
	return math.min(C.MaxNumber, math.max(0, n))
end
function Game.daily(d)
	local day = math.floor(os.time() / 86400)
	if d.Daily.Day ~= day then
		d.Daily = { Day = day, Crystals = 0, Coins = 0, Eggs = 0, Claimed = {} }
	end
end
function Game.mult(d, kind)
	local value = 1
	for _, uid in ipairs(d.Equipped) do
		for _, pet in ipairs(d.Pets) do
			if pet.Uid == uid then
				value += C.Pets[pet.Id][kind] or 0
				break
			end
		end
	end
	if kind == "Coins" or kind == "Damage" then
		value *= B.rebirthMultiplier(d.Rebirths)
	end
	if kind == "Coins" then
		value *= C.Tools[d.Tool].Coins
	end
	if d.Passes["Double" .. kind] then
		value *= 2
	end
	if (d.Boosts[kind] or 0) > os.time() then
		value *= 2
	end
	local e = Game.event()
	if e.Active and e.Kind == kind then
		value *= 2
	end
	return value
end
function Game.snapshot(player)
	local s = Data.Sessions[player]
	if not s then
		return
	end
	Game.daily(s.Data)
	local d = s.Data
	local view = {}
	for _, key in ipairs({
		"Coins",
		"Gems",
		"Rebirths",
		"Tool",
		"World",
		"Unlocked",
		"Pets",
		"Equipped",
		"Passes",
		"Settings",
		"Boosts",
		"Bag",
		"BagCount",
		"EggCredits",
		"Crystals",
		"TotalCoins",
		"TotalPets",
		"Daily",
	}) do
		view[key] = d[key]
	end
	local ids = {}
	for _, pet in ipairs(d.Pets) do
		table.insert(ids, pet.Uid)
	end
	local signature = table.concat(ids, ",") .. "|" .. table.concat(d.Equipped, ",")
	local rt = Game.Runtime[player]
	if rt and rt.InventorySignature == signature then
		view.Pets = nil
		view.Equipped = nil
	elseif rt then
		rt.InventorySignature = signature
	end
	view.Temporary = s.Temporary
	view.Event = Game.event()
	view.CoinMultiplier = Game.mult(d, "Coins")
	view.DamageMultiplier = Game.mult(d, "Damage")
	view.RebirthCost = B.rebirthCost(d.Rebirths)
	view.Level = B.level(d.Crystals)
	view.AutoMine = Game.Runtime[player] and Game.Runtime[player].AutoMine or false
	Game.emit(player, "State", view)
end
function Game.gems(d, amount, boosted)
	d.Gems = clamp(d.Gems + math.floor(amount * (boosted and Game.mult(d, "Gems") or 1)))
end
function Game.coins(d, amount)
	amount = math.floor(amount)
	d.Coins = clamp(d.Coins + amount)
	d.TotalCoins = clamp(d.TotalCoins + amount)
	Game.daily(d)
	d.Daily.Coins = clamp(d.Daily.Coins + amount)
end
function Game.pet(d, id)
	local pet = { Uid = Http:GenerateGUID(false), Id = id }
	table.insert(d.Pets, pet)
	d.TotalPets += 1
	if #d.Equipped < B.petSlots(d) then
		table.insert(d.Equipped, pet.Uid)
	end
	return pet
end
function Game.sell(player)
	local d = Data.Sessions[player].Data
	if d.Bag <= 0 then
		return
	end
	local value = d.Bag
	d.Bag = 0
	d.BagCount = 0
	Game.coins(d, value)
	Game.emit(player, "Reward", { Coins = value, Text = "Mochila vendida!" })
end
function Game.mine(player, id)
	if not Data.writable(player) then
		return
	end
	local s = Data.Sessions[player]
	local d = s.Data
	local rt = Game.Runtime[player]
	local c = Map.Crystals[id]
	if not c or c.Health <= 0 or c.World ~= d.World then
		return
	end
	local radius = d.Passes.Magnet and 55 or 24
	if not Map.near(player, c.Part.Position, radius) then
		return
	end
	local now = os.clock()
	local tool = C.Tools[d.Tool]
	if now - rt.LastHit < tool.Interval then
		return
	end
	if (d.BagCount or 0) >= C.BaseBackpack and not d.Passes.InfiniteBackpack then
		if d.Passes.AutoSell then
			Game.sell(player)
		else
			if now - rt.LastBagNotice > 3 then
				Game.notice(player, "Mochila cheia: use SELL ou o botão Vender.")
				rt.LastBagNotice = now
			end
			return
		end
	end
	rt.LastHit = now
	local destroyed = Map.hit(c, tool.Damage * Game.mult(d, "Damage"))
	Game.emit(player, "MineFX", { Position = c.Part.Position, Destroyed = destroyed })
	if destroyed then
		local level = B.level(d.Crystals)
		d.Crystals += 1
		Game.daily(d)
		d.Daily.Crystals += 1
		local reward = math.floor(C.Worlds[c.World].Reward * (c.Rare and 8 or 1) * Game.mult(d, "Coins"))
		d.Bag = clamp(d.Bag + reward)
		d.BagCount = (d.BagCount or 0) + 1
		Game.emit(player, "Reward", { Coins = reward, Text = "+" .. B.compact(reward) .. " na mochila" })
		if d.Passes.AutoSell then
			Game.sell(player)
		end
		if B.level(d.Crystals) > level then
			Game.gems(d, 5, true)
			Game.emit(
				player,
				"Celebration",
				{ Kind = "Level", Text = "Nível " .. B.level(d.Crystals) .. " • +5 Gems" }
			)
		end
		local event = Game.event()
		if event.Active then
			Game.gems(d, 1, true)
			if event.Kind == "Exclusive" and #d.Pets < C.MaxPets and rng:NextNumber() < 0.002 then
				Game.pet(d, "event")
				Game.emit(player, "Hatch", { { Id = "event" } })
			end
		end
	end
end
local function rarity(d)
	return Economy.rarity(C.Weights, Game.mult(d, "Luck"), rng:NextNumber())
end
function Game.hatch(player, count)
	local d = Data.Sessions[player].Data
	local rt = Game.Runtime[player]
	if count ~= 1 and count ~= 3 then
		return
	end
	if count == 3 and not d.Passes.TripleHatch then
		return Game.notice(player, "Triple Hatch necessário.")
	end
	local now = os.clock()
	local interval = d.Passes.FastHatch and 1 or 3
	if now - rt.LastHatch < interval then
		return
	end
	if not Map.near(player, Map.Eggs[d.World].Position, 20) then
		return Game.notice(player, "Aproxime-se do ovo do seu mundo.")
	end
	local plan, reason = Economy.hatchPlan(C.Worlds[d.World].EggCost, d.Coins, d.EggCredits, count, #d.Pets, C.MaxPets)
	if not plan then
		return Game.notice(
			player,
			reason == "Capacity" and "Inventário cheio: libere espaço em Pets." or "Coins insuficientes."
		)
	end
	rt.LastHatch = now
	d.Coins -= plan.Cost
	d.EggCredits -= plan.Credits
	local results = {}
	for _ = 1, count do
		local rank = rarity(d)
		local id = "w" .. d.World .. "r" .. rank
		local p = Game.pet(d, id)
		table.insert(results, p)
		if rank >= 6 then
			local msg = player.DisplayName .. " encontrou " .. C.Pets[id].Name .. " (" .. C.Pets[id].Rarity .. ")!"
			outbound:FireAllClients("Global", msg)
			task.spawn(function()
				pcall(function()
					Messaging:PublishAsync("UM_Rare_v1", { Job = game.JobId, Text = msg })
				end)
			end)
		end
	end
	Game.daily(d)
	d.Daily.Eggs += count
	Game.emit(player, "Hatch", results)
end
function Game.rebirth(player)
	local d = Data.Sessions[player].Data
	local cost = B.rebirthCost(d.Rebirths)
	if d.Coins < cost then
		return Game.notice(player, "Você precisa de " .. B.compact(cost) .. " Coins.")
	end
	d.Coins = 0
	d.Bag = 0
	d.BagCount = 0
	d.Tool = 1
	d.Unlocked = { ["1"] = true }
	d.World = 1
	d.Rebirths += 1
	Game.gems(d, 50 + math.min(d.Rebirths, 10000) * 10, true)
	Map.teleport(player, 1)
	Game.emit(
		player,
		"Celebration",
		{ Kind = "Rebirth", Text = "REBIRTH! Multiplicador permanente " .. B.rebirthMultiplier(d.Rebirths) .. "x" }
	)
end
function Game.action(player, action, arg)
	if not Data.writable(player) then
		return
	end
	local d = Data.Sessions[player].Data
	local rt = Game.Runtime[player]
	if action == "Mine" then
		if type(arg) == "number" and arg == arg then
			Game.mine(player, arg)
		end
		return
	end
	if action == "Sync" then
		Game.snapshot(player)
		return
	end
	if action == "Sell" then
		Game.sell(player)
	elseif action == "Tool" then
		local nextTool = C.Tools[d.Tool + 1]
		if nextTool and d.Coins >= nextTool.Cost then
			d.Coins -= nextTool.Cost
			d.Tool += 1
			Game.emit(player, "Celebration", { Kind = "Level", Text = nextTool.Name })
		else
			Game.notice(player, "Coins insuficientes ou ferramenta máxima.")
		end
	elseif action == "World" then
		if type(arg) ~= "number" or arg % 1 ~= 0 or not C.Worlds[arg] then
			return
		end
		local w = C.Worlds[arg]
		if not d.Unlocked[tostring(arg)] then
			if d.Rebirths < w.RequiredRebirths then
				return Game.notice(player, "Requer " .. w.RequiredRebirths .. " rebirths.")
			end
			if not d.Passes.TeleportAllWorlds then
				if arg > 1 and not d.Unlocked[tostring(arg - 1)] then
					return Game.notice(player, "Desbloqueie o mundo anterior.")
				end
				if d.Coins < w.Cost then
					return Game.notice(player, "Coins insuficientes.")
				end
				d.Coins -= w.Cost
			end
			d.Unlocked[tostring(arg)] = true
		end
		d.World = arg
		Map.teleport(player, arg)
	elseif action == "Hatch" then
		Game.hatch(player, arg)
	elseif action == "Rebirth" then
		Game.rebirth(player)
	elseif action == "AutoMine" then
		if d.Passes.AutoMine then
			rt.AutoMine = not rt.AutoMine
		else
			Game.notice(player, "Auto Mine necessário.")
		end
	elseif action == "Equip" or action == "DeletePet" then
		if type(arg) ~= "string" or #arg > 40 then
			return
		end
		for index, pet in ipairs(d.Pets) do
			if pet.Uid == arg then
				local equipped = table.find(d.Equipped, arg)
				if action == "DeletePet" then
					if equipped then
						return Game.notice(player, "Desequipe antes de excluir.")
					end
					table.remove(d.Pets, index)
				elseif equipped then
					table.remove(d.Equipped, equipped)
				elseif #d.Equipped < B.petSlots(d) then
					table.insert(d.Equipped, arg)
				else
					Game.notice(player, "Slots de pets cheios.")
				end
				break
			end
		end
	elseif action == "EquipBest" then
		local pets = table.clone(d.Pets)
		table.sort(pets, function(a, b)
			return C.Pets[a.Id].Coins + C.Pets[a.Id].Damage > C.Pets[b.Id].Coins + C.Pets[b.Id].Damage
		end)
		d.Equipped = {}
		for i = 1, math.min(#pets, B.petSlots(d)) do
			table.insert(d.Equipped, pets[i].Uid)
		end
	elseif action == "Quest" then
		if type(arg) ~= "number" or not C.Quests[arg] then
			return
		end
		Game.daily(d)
		local q = C.Quests[arg]
		if d.Daily.Claimed[tostring(arg)] or (d.Daily[q.Key] or 0) < q.Target then
			return
		end
		if q.Reward == "daily" and #d.Pets >= C.MaxPets then
			return Game.notice(player, "Libere espaço em Pets.")
		end
		d.Daily.Claimed[tostring(arg)] = true
		Game.gems(d, q.Gems, true)
		if q.Reward == "daily" then
			Game.pet(d, "daily")
		else
			d.Boosts[q.Reward] = math.max(os.time(), d.Boosts[q.Reward] or 0) + 900
		end
		Game.notice(player, "Missão concluída! Gems e recompensa entregues.")
	elseif action == "Code" then
		if type(arg) ~= "string" or #arg > 40 then
			return
		end
		arg = string.upper(arg)
		local code = C.Codes[arg]
		if code and not d.Codes[arg] then
			d.Codes[arg] = true
			Game.gems(d, code.Gems, false)
			Game.notice(player, "Código resgatado!")
		else
			Game.notice(player, "Código inválido ou já resgatado.")
		end
	elseif action == "Setting" then
		if arg == "Music" or arg == "Effects" then
			d.Settings[arg] = not d.Settings[arg]
		end
	end
	Game.snapshot(player)
end
function Game.join(player)
	Game.Runtime[player] = {
		LastHit = -10,
		LastHatch = -10,
		LastBagNotice = -10,
		AutoMine = false,
		LastAFK = os.clock(),
		Tokens = 35,
		TokenAt = os.clock(),
	}
	local s = Data.Sessions[player]
	s.Data.BagCount = s.Data.BagCount or 0
end
function Game.rate(player)
	local rt = Game.Runtime[player]
	if not rt then
		return false
	end
	local now = os.clock()
	rt.Tokens = math.min(35, rt.Tokens + (now - rt.TokenAt) * 20)
	rt.TokenAt = now
	if rt.Tokens < 1 then
		return false
	end
	rt.Tokens -= 1
	return true
end
function Game.tick()
	Map.step()
	for player, rt in pairs(Game.Runtime) do
		if Data.writable(player) then
			local d = Data.Sessions[player].Data
			if rt.AutoMine and d.Passes.AutoMine then
				local nearest, dist = nil, math.huge
				for id, c in pairs(Map.Crystals) do
					if
						c.World == d.World
						and c.Health > 0
						and Map.near(player, c.Part.Position, d.Passes.Magnet and 55 or 24)
					then
						local root = player.Character.HumanoidRootPart
						local distance = (root.Position - c.Part.Position).Magnitude
						if distance < dist then
							nearest = id
							dist = distance
						end
					end
				end
				if nearest then
					Game.mine(player, nearest)
				end
			end
			if d.Passes.AutoSell and d.Bag > 0 then
				Game.sell(player)
			end
			if Map.near(player, Map.Sell[d.World].Position, 12) then
				Game.sell(player)
			end
			if os.clock() - rt.LastAFK >= 30 then
				rt.LastAFK = os.clock()
				for _, zone in ipairs(Map.AFK) do
					if Map.near(player, zone.Part.Position, 12) and (not zone.VIP or d.Passes.VIP) then
						local mult = (zone.VIP and 3 or 1) * (d.Passes.PremiumAFK and 2 or 1)
						local coins = math.floor(20 * mult * Game.mult(d, "Coins"))
						Game.coins(d, coins)
						Game.gems(d, mult, true)
						Game.emit(player, "Reward", { Coins = coins, Text = "AFK • +" .. coins .. " Coins" })
						break
					end
				end
			end
		end
	end
end
function Game.subscribe()
	task.spawn(function()
		local ok, err = pcall(function()
			Messaging:SubscribeAsync("UM_Rare_v1", function(message)
				local payload = message.Data
				if type(payload) == "table" and payload.Job ~= game.JobId and type(payload.Text) == "string" then
					outbound:FireAllClients("Global", payload.Text)
				end
			end)
		end)
		if not ok then
			warn("Anúncios entre servidores indisponíveis:", err)
		end
	end)
end
return Game
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="11">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local C = require(game.ReplicatedStorage.UniverseMiner.Config)
local Data = require(script.Parent.Data)
local Map = require(script.Parent.Map)
local Game = require(script.Parent.Game)
local Commerce = require(script.Parent.Commerce)
local Rankings = require(script.Parent.Rankings)
local shared = game.ReplicatedStorage.UniverseMiner
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = shared
local action = Instance.new("RemoteEvent")
action.Name = "Action"
action.Parent = remotes
local updates = Instance.new("RemoteEvent")
updates.Name = "Update"
updates.Parent = remotes
Game.init(updates)
Map.build()
Commerce.init()
Game.subscribe()
local closing = false
local function character(player, char)
	local root = char:WaitForChild("HumanoidRootPart", 10)
	if not root then
		return
	end
	for _ = 1, 100 do
		if Data.Sessions[player] then
			break
		end
		task.wait(0.1)
	end
	local s = Data.Sessions[player]
	if not s then
		return
	end
	Map.teleport(player, s.Data.World)
	local hand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
	if hand and not char:FindFirstChild("PickaxeHandle") then
		local handle = Instance.new("Part")
		handle.Name = "PickaxeHandle"
		handle.Size = Vector3.new(0.3, 3, 0.3)
		handle.Color = Color3.fromRGB(115, 78, 48)
		handle.CanCollide = false
		handle.Massless = true
		handle.Parent = char
		local weld = Instance.new("Weld")
		weld.Part0 = hand
		weld.Part1 = handle
		weld.C0 = CFrame.new(0, -0.6, -0.5) * CFrame.Angles(math.rad(40), 0, 0)
		weld.Parent = handle
		local head = Instance.new("Part")
		head.Name = "PickaxeHead"
		head.Size = Vector3.new(2.5, 0.45, 0.55)
		head.Color = Color3.fromRGB(137, 202, 230)
		head.Material = Enum.Material.Metal
		head.CanCollide = false
		head.Massless = true
		head.Parent = char
		local joint = Instance.new("Weld")
		joint.Part0 = handle
		joint.Part1 = head
		joint.C0 = CFrame.new(0, 1.3, 0)
		joint.Parent = head
	end
end
local function join(player)
	player.CharacterAdded:Connect(function(char)
		task.spawn(character, player, char)
	end)
	local s, err = Data.load(player)
	if not s then
		player:Kick(err)
		return
	end
	if not player.Parent or closing then
		Data.release(player)
		return
	end
	Game.join(player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	stats.Parent = player
	for _, key in ipairs({ "Coins", "Gems", "Rebirths" }) do
		local v = Instance.new("NumberValue")
		v.Name = key
		v.Parent = stats
	end
	if player.Character then
		task.spawn(character, player, player.Character)
	end
	Game.snapshot(player)
	task.spawn(Commerce.refresh, player)
end
Players.PlayerAdded:Connect(join)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(join, player)
end
Players.PlayerRemoving:Connect(function(player)
	Game.Runtime[player] = nil
	local s = Data.Sessions[player]
	if s and not s.Temporary then
		task.spawn(Rankings.write, player, s.Data)
	end
	Data.release(player)
end)
action.OnServerEvent:Connect(function(player, key, arg)
	if type(key) ~= "string" or #key > 20 or not Game.rate(player) or not Data.writable(player) then
		return
	end
	if key == "Purchase" then
		Commerce.prompt(player, arg)
	elseif key == "Rankings" then
		Game.emit(player, "Rankings", { Rows = Rankings.Cache, Updated = Rankings.Updated })
	else
		Game.action(player, key, arg)
	end
end)
task.spawn(function()
	while not closing do
		Game.tick()
		task.wait(0.15)
	end
end)
task.spawn(function()
	while not closing do
		task.wait(2)
		for player, s in pairs(Data.Sessions) do
			if not s.Closing then
				Game.snapshot(player)
				local stats = player:FindFirstChild("leaderstats")
				if stats then
					for _, key in ipairs({ "Coins", "Gems", "Rebirths" }) do
						stats[key].Value = s.Data[key]
					end
				end
			end
		end
	end
end)
task.spawn(function()
	while not closing do
		task.wait(C.AutosaveSeconds)
		for player, s in pairs(Data.Sessions) do
			if not s.Closing then
				task.spawn(function()
					if Data.save(player, false) and not s.Temporary then
						Rankings.write(player, s.Data)
					end
				end)
			end
		end
	end
end)
task.spawn(function()
	while not closing do
		Rankings.refresh()
		task.wait(180)
	end
end)
game:BindToClose(function()
	closing = true
	local count = 0
	for player, s in pairs(Data.Sessions) do
		if not s.Closing then
			count += 1
			task.spawn(function()
				Data.release(player)
				count -= 1
			end)
		end
	end
	local deadline = os.clock() + 25
	while count > 0 and os.clock() < deadline do
		task.wait(0.1)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Map</string>
          <string name="Source"><![CDATA[local C = require(game.ReplicatedStorage.UniverseMiner.Config)
local Map = { Crystals = {}, Spawns = {}, Eggs = {}, AFK = {}, Sell = {} }
local rng = Random.new()
local function part(name, size, pos, color, parent)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Position = pos
	p.Color = color
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end
local function label(p, text)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(230, 55)
	gui.StudsOffset = Vector3.new(0, 4, 0)
	gui.MaxDistance = 100
	gui.Parent = p
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Text = text
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0.2
	t.Font = Enum.Font.GothamBold
	t.TextScaled = true
	t.Parent = gui
	return t
end
function Map.build()
	local root = Instance.new("Folder")
	root.Name = "UniverseMap"
	root.Parent = workspace
	for i, w in ipairs(C.Worlds) do
		local folder = Instance.new("Folder")
		folder.Name = w.Name
		folder.Parent = root
		local base = Vector3.new((i - 1) * 280, 0, 0)
		local col = Color3.fromRGB(table.unpack(w.Color))
		part("Island", Vector3.new(160, 8, 160), base + Vector3.new(0, -4, 0), col, folder)
		for _, edge in ipairs({ { 0, 0, 80, 160, 20, 2 }, { 0, 0, -80, 160, 20, 2 }, { 80, 0, 0, 2, 20, 160 }, {
			-80,
			0,
			0,
			2,
			20,
			160,
		} }) do
			part(
				"Boundary",
				Vector3.new(edge[4], edge[5], edge[6]),
				base + Vector3.new(edge[1], 7, edge[3]),
				col:Lerp(Color3.new(0, 0, 0), 0.3),
				folder
			)
		end
		Map.Spawns[i] = base + Vector3.new(0, 5, 55)
		local sign = part("WorldSign", Vector3.new(18, 3, 2), base + Vector3.new(0, 5, 69), col, folder)
		label(sign, w.Name)
		local egg =
			part("Egg", Vector3.new(5, 7, 5), base + Vector3.new(-45, 4, 48), Color3.fromRGB(255, 213, 82), folder)
		egg.Shape = Enum.PartType.Ball
		egg.Material = Enum.Material.Neon
		Map.Eggs[i] = egg
		label(egg, "EGG • " .. w.EggCost .. " Coins")
		local sell = part(
			"Sell",
			Vector3.new(16, 0.5, 16),
			base + Vector3.new(35, 0.4, 52),
			Color3.fromRGB(255, 207, 60),
			folder
		)
		Map.Sell[i] = sell
		label(sell, "SELL • vender mochila")
		for slot = 1, 20 do
			local x = ((slot - 1) % 5 - 2) * 22
			local z = math.floor((slot - 1) / 5) * 22 - 48
			local crystal = part("Crystal", Vector3.new(5, 9, 5), base + Vector3.new(x, 5, z), col, folder)
			crystal.Material = Enum.Material.Neon
			crystal.CanCollide = false
			local id = i * 100 + slot
			crystal:SetAttribute("CrystalId", id)
			local text = label(crystal, "")
			Map.Crystals[id] = { Part = crystal, Label = text, World = i, RespawnAt = 0 }
			Map.reset(Map.Crystals[id])
		end
		for k = 1, 8 do
			local p = part(
				"Decoration",
				Vector3.new(4, 12 + k % 3 * 4, 4),
				base + Vector3.new(k % 2 == 0 and -70 or 70, 7, k * 15 - 65),
				col:Lerp(Color3.new(1, 1, 1), 0.2),
				folder
			)
			if i == 2 then
				p.Material = Enum.Material.Grass
			elseif i >= 7 then
				p.Material = Enum.Material.Neon
			end
		end
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "UniverseSpawn"
	spawn.Size = Vector3.new(10, 1, 10)
	spawn.Position = Map.Spawns[1] - Vector3.new(0, 4, 0)
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = root
	for _, vip in ipairs({ false, true }) do
		local p = part(
			vip and "VIPAFK" or "AFK",
			Vector3.new(18, 1, 18),
			Vector3.new(vip and 55 or -55, 0.5, 68),
			vip and Color3.fromRGB(255, 201, 40) or Color3.fromRGB(76, 211, 244),
			root
		)
		label(p, vip and "VIP AFK • 3x" or "AFK Rewards")
		table.insert(Map.AFK, { Part = p, VIP = vip })
	end
end
function Map.reset(c)
	local rare = rng:NextNumber() < 0.07
	local w = C.Worlds[c.World]
	c.Rare = rare
	c.MaxHealth = w.Health * (rare and 4 or 1)
	c.Health = c.MaxHealth
	c.RespawnAt = 0
	c.Part.Transparency = 0
	c.Part:SetAttribute("Health", c.Health)
	c.Part:SetAttribute("MaxHealth", c.MaxHealth)
	c.Part.Color = rare and Color3.fromRGB(255, 222, 65) or Color3.fromRGB(table.unpack(w.Color))
	c.Label.Text = (rare and "★ RARE " or "") .. c.Health .. " HP"
	c.Part:SetAttribute("Alive", true)
end
function Map.hit(c, damage)
	c.Health = math.max(0, c.Health - damage)
	c.Part:SetAttribute("Health", c.Health)
	c.Label.Text = c.Health .. " HP"
	if c.Health == 0 then
		c.Part.Transparency = 1
		c.Label.Text = ""
		c.Part:SetAttribute("Alive", false)
		c.RespawnAt = os.clock() + 5
		return true
	end
	return false
end
function Map.step()
	for _, c in pairs(Map.Crystals) do
		if c.RespawnAt > 0 and os.clock() >= c.RespawnAt then
			Map.reset(c)
		end
	end
end
function Map.teleport(player, world)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if root then
		root.CFrame = CFrame.new(Map.Spawns[world])
	end
end
function Map.near(player, position, distance)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	return root and h and h.Health > 0 and (root.Position - position).Magnitude <= distance
end
return Map
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">Rankings</string>
          <string name="Source"><![CDATA[local DSS = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local C = require(game.ReplicatedStorage.UniverseMiner.Config)
local Rankings = { Cache = {}, Updated = 0, Busy = false }
local stores = {}
for _, key in ipairs({ "Coins", "Rebirths", "Pets", "Gems" }) do
	stores[key] = DSS:GetOrderedDataStore(C.DataStore .. "_Rank_" .. key)
end
-- OrderedDataStore accepts signed integers, not arbitrary large doubles.
local function encode(value)
	return math.floor(math.log10(1 + value) * 1000000)
end
local function decode(value)
	return 10 ^ (value / 1000000) - 1
end
function Rankings.write(player, d)
	local values = { Coins = d.TotalCoins, Rebirths = d.Rebirths, Pets = d.TotalPets, Gems = d.Gems }
	for key, value in pairs(values) do
		local ok, err = pcall(function()
			stores[key]:SetAsync(tostring(player.UserId), encode(value))
		end)
		if not ok then
			warn("Ranking " .. key .. ":", err)
		end
	end
end
function Rankings.refresh()
	if Rankings.Busy then
		return
	end
	Rankings.Busy = true
	for key, store in pairs(stores) do
		local ok, result = pcall(function()
			return store:GetSortedAsync(false, 20):GetCurrentPage()
		end)
		if ok then
			local rows = {}
			for _, entry in ipairs(result) do
				local userId = tonumber(entry.key)
				local name = "User " .. entry.key
				if userId then
					local found, username = pcall(function()
						return Players:GetNameFromUserIdAsync(userId)
					end)
					if found then
						name = username
					end
				end
				table.insert(rows, { Name = name, Value = decode(entry.value), UserId = userId })
			end
			Rankings.Cache[key] = rows
		else
			warn("Leitura de ranking indisponível:", key)
		end
	end
	Rankings.Updated = os.time()
	Rankings.Busy = false
end
return Rankings
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="14">
    <Properties>
      <string name="Name">StarterPlayer</string>
