      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Balance</string>
          <string name="Source"><![CDATA[local B = {}
function B.rebirthCost(count)
	return math.min(1e150, math.floor(25000 * 1.65 ^ math.min(count, 670)))
end
function B.rebirthMultiplier(count)
	return 1 + count * 0.5
end
function B.petSlots(data)
	return 3 + (data.Passes.ExtraPetSlots and 3 or 0)
end
function B.level(crystals)
	return 1 + math.floor(math.sqrt(crystals / 8))
end
function B.compact(n)
	local units = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No" }
	if n < 1000 then
		return tostring(math.floor(n))
	end
	local tier = math.floor(math.log10(n) / 3)
	if tier >= #units then
		return string.format("%.2e", n)
	end
	return string.format("%.1f%s", n / 1000 ^ tier, units[tier + 1])
end
return B
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[local C = {}
C.Title = "Universe Miner Simulator"
C.DataStore = "UniverseMiner_v1"
C.StudioTemporaryData = true
C.MaxNumber = 1e150
C.MaxPets = 400
C.BasePetSlots = 3
C.BaseBackpack = 30
C.AutosaveSeconds = 60
C.EventPeriod = 7200
C.EventDuration = 900
C.MusicId = "" -- áudio autorizado opcional
C.SoundIds = { Mine = "", Reward = "", Hatch = "", Rebirth = "", Level = "" } -- IDs de áudio autorizado
C.Worlds = {}
local names = { "Starter", "Forest", "Desert", "Ocean", "Candy", "Volcano", "Space", "Galaxy", "Void", "Heaven" }
local colors = {
	{ 94, 195, 115 },
	{ 40, 139, 73 },
	{ 234, 195, 93 },
	{ 55, 176, 218 },
	{ 238, 125, 193 },
	{ 220, 80, 41 },
	{ 73, 92, 150 },
	{ 127, 74, 213 },
	{ 53, 32, 83 },
	{ 232, 215, 157 },
}
for i, name in ipairs(names) do
	C.Worlds[i] = {
		Name = name .. " World",
		Cost = i == 1 and 0 or math.floor(1500 * 5 ^ (i - 2)),
		Health = math.floor(10 * 3 ^ (i - 1)),
		Reward = math.floor(15 * 4 ^ (i - 1)),
		EggCost = math.floor(100 * 4 ^ (i - 1)),
		Color = colors[i],
		RequiredRebirths = i >= 9 and (i - 8) * 2 or 0,
	}
end
C.Tools = {}
local tiers = { "Wood", "Stone", "Iron", "Gold", "Diamond", "Emerald", "Galaxy", "Void", "God" }
for i = 1, 36 do
	C.Tools[i] = {
		Name = tiers[math.ceil(i / 4)] .. " Pickaxe " .. ((i - 1) % 4 + 1),
		Cost = i == 1 and 0 or math.floor(70 * 1.9 ^ (i - 2)),
		Damage = math.floor(3 * 1.48 ^ (i - 1)),
		Interval = math.max(0.12, 0.55 - 0.012 * (i - 1)),
		Coins = 1 + (i - 1) * 0.08,
	}
end
C.Rarities = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythical", "Secret" }
C.Weights = { 6000, 2500, 1000, 400, 85, 14, 1 }
C.Pets = {}
local species = { "Sprite", "Fox", "Golem", "Dragon", "Phoenix", "Titan", "Oracle" }
for world = 1, 10 do
	for rarity, label in ipairs(C.Rarities) do
		local id = "w" .. world .. "r" .. rarity
		C.Pets[id] = {
			Name = names[world] .. " " .. species[rarity],
			Rarity = label,
			Rank = rarity,
			World = world,
			Coins = 0.10 * world * rarity,
			Damage = 0.12 * world * rarity,
			Gems = 0.03 * rarity,
		}
	end
end
C.Pets.daily = { Name = "Daily Comet", Rarity = "Epic", Rank = 4, World = 1, Coins = 0.8, Damage = 0.8, Gems = 0.2 }
C.Pets.event = { Name = "Event Nebula", Rarity = "Mythical", Rank = 6, World = 7, Coins = 3, Damage = 3, Gems = 0.4 }
C.Pets.weekly =
	{ Name = "Weekly Supernova", Rarity = "Mythical", Rank = 6, World = 8, Coins = 4, Damage = 4, Gems = 0.5 }
C.Pets.vip = { Name = "Royal Star", Rarity = "Legendary", Rank = 5, World = 6, Coins = 2, Damage = 2, Gems = 0.3 }
-- IDs zero desativam compras. Use IDs únicos da mesma experiência.
C.Passes = {}
for _, name in ipairs({
	"DoubleCoins",
	"DoubleLuck",
	"DoubleGems",
	"AutoMine",
	"AutoSell",
	"InfiniteBackpack",
	"VIP",
	"FastHatch",
	"TripleHatch",
	"TeleportAllWorlds",
	"ExtraPetSlots",
	"Magnet",
	"ExclusivePets",
	"InstantRebirth",
	"PremiumAFK",
}) do
	C.Passes[name] = 0
end
C.PassLabels = {
	DoubleCoins = "2x Coins",
	DoubleLuck = "2x Luck",
	DoubleGems = "2x Gems",
	AutoMine = "Auto Mine",
	AutoSell = "Auto Sell",
	InfiniteBackpack = "Infinite Backpack",
	VIP = "VIP",
	FastHatch = "Fast Hatch",
	TripleHatch = "Triple Hatch",
	TeleportAllWorlds = "Teleport All Worlds",
	ExtraPetSlots = "+3 Pet Slots",
	Magnet = "Magnet",
	ExclusivePets = "Exclusive Pet",
	InstantRebirth = "Rebirth sem confirmação",
	PremiumAFK = "Premium AFK Rewards",
}
C.Products = {
	Gems50 = { Id = 0, Kind = "Gems", Amount = 50, Label = "50 Gems" },
	Gems500 = { Id = 0, Kind = "Gems", Amount = 500, Label = "500 Gems" },
	Gems5000 = { Id = 0, Kind = "Gems", Amount = 5000, Label = "5000 Gems" },
	Luck15 = { Id = 0, Kind = "Luck", Amount = 900, Label = "Luck • 15 min" },
	Luck30 = { Id = 0, Kind = "Luck", Amount = 1800, Label = "Luck • 30 min" },
	Coins15 = { Id = 0, Kind = "Coins", Amount = 900, Label = "Coins • 15 min" },
	Coins30 = { Id = 0, Kind = "Coins", Amount = 1800, Label = "Coins • 30 min" },
	Eggs10 = { Id = 0, Kind = "Eggs", Amount = 10, Label = "10 créditos de ovo" },
	Eggs100 = { Id = 0, Kind = "Eggs", Amount = 100, Label = "100 créditos de ovo" },
	WeeklyPet = { Id = 0, Kind = "Pet", Pet = "weekly", Amount = 1, Label = "Weekly Supernova" },
}
C.Quests = {
	{ Key = "Crystals", Target = 100, Gems = 75, Reward = "Coins" },
	{ Key = "Coins", Target = 10000, Gems = 100, Reward = "Luck" },
	{ Key = "Eggs", Target = 15, Gems = 150, Reward = "daily" },
}
C.Codes = { WELCOME = { Gems = 100 }, UNIVERSE = { Gems = 250 } }
return C
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source"><![CDATA[-- Pure operations used by the authoritative server and offline tests.
local E = {}
function E.rarity(weights, luck, roll)
	local sum = 0
	for i, w in ipairs(weights) do
		sum += w * (i >= 3 and luck or 1)
	end
	local cursor = 0
	for i, w in ipairs(weights) do
		cursor += w * (i >= 3 and luck or 1)
		if roll * sum < cursor then
			return i
		end
	end
	return #weights
end
function E.hatchPlan(cost, coins, credits, count, petCount, limit)
	if count ~= 1 and count ~= 3 then
		return nil, "Count"
	end
	if petCount + count > limit then
		return nil, "Capacity"
	end
	local used = math.min(count, credits)
	local price = cost * (count - used)
	if coins < price then
		return nil, "Coins"
	end
	return { Cost = price, Credits = used }
end
function E.receipt(d, receiptKey, product, now, petFactory, maxNumber)
	if d.Receipts[receiptKey] then
		return true, false
	end
	if product.Kind == "Gems" then
		d.Gems = math.min(maxNumber, d.Gems + product.Amount)
	elseif product.Kind == "Coins" or product.Kind == "Luck" then
		d.Boosts[product.Kind] = math.max(now, d.Boosts[product.Kind] or 0) + product.Amount
	elseif product.Kind == "Eggs" then
		d.EggCredits += product.Amount
	elseif product.Kind == "Pet" then
		petFactory(d, product.Pet)
	else
		return false, false
	end
	d.Receipts[receiptKey] = now
	return true, true
end
return E
]]></string>
        </Properties>
      </Item>
    </Item>
