      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Economy</string>
          <string name="Source">-- Pure operations used by the authoritative server and offline tests.
local E = {}
function E.rarity(weights, luck, roll)
	local sum = 0
	for i, w in ipairs(weights) do
		sum += w * (i &gt;= 3 and luck or 1)
	end
	local cursor = 0
	for i, w in ipairs(weights) do
		cursor += w * (i &gt;= 3 and luck or 1)
		if roll * sum &lt; cursor then
			return i
		end
	end
	return #weights
end
function E.hatchPlan(cost, coins, credits, count, petCount, limit)
	if count ~= 1 and count ~= 3 then
		return nil, "Count"
	end
	if petCount + count &gt; limit then
		return nil, "Capacity"
	end
	local used = math.min(count, credits)
	local price = cost * (count - used)
	if coins &lt; price then
		return nil, "Coins"
	end
	return { Cost = price, Credits = used }
end
function E.receipt(d, receiptKey, product, now, petFactory, maxNumber)
	if d.Receipts[receiptKey] then
		return true, false
	end
	if product.Kind == "Gems" then
		d.Gems = math.min(maxNumber, d.Gems + product.Amount)
	elseif product.Kind == "Coins" or product.Kind == "Luck" then
		d.Boosts[product.Kind] = math.max(now, d.Boosts[product.Kind] or 0) + product.Amount
	elseif product.Kind == "Eggs" then
		d.EggCredits += product.Amount
	elseif product.Kind == "Pet" then
		petFactory(d, product.Pet)
	else
		return false, false
	end
	d.Receipts[receiptKey] = now
	return true, true
end
return E
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Progression</string>
          <string name="Source">local P = {}
function P.upgradeCost(upgrade, level)
	return math.floor(upgrade.Base * upgrade.Growth ^ level)
end
function P.capacity(data, base)
	return base + (data.Upgrades.Backpack or 0) * 15
end
function P.variant(tier)
	return 2.5 ^ math.clamp(tier or 0, 0, 2)
end
function P.combo(count)
	return 1 + math.min(20, math.max(0, count)) * 0.025
end
function P.streak(lastDay, streak, day)
	if lastDay == day then
		return nil
	end
	return lastDay == day - 1 and streak % 7 + 1 or 1
end
function P.fusion(pets, equipped, uid)
	local selected
	for _, p in ipairs(pets) do
		if p.Uid == uid then
			selected = p
			break
		end
	end
	if not selected or (selected.Tier or 0) &gt;= 2 then
		return nil
	end
	local found = {}
	for _, p in ipairs(pets) do
		if p.Id == selected.Id and (p.Tier or 0) == (selected.Tier or 0) and not table.find(equipped, p.Uid) then
			table.insert(found, p.Uid)
		end
		if #found == 3 then
			return {
				Ids = found,
				PetId = selected.Id,
				Tier = (selected.Tier or 0) + 1,
				Cost = 50 * 5 ^ (selected.Tier or 0),
			}
		end
	end
	return nil
end
function P.value(data, key)
	if key == "WorldCount" then
		local n = 0
		for _, yes in pairs(data.VisitedWorlds or data.Unlocked) do
			if yes then
				n += 1
			end
		end
		return n
	end
	return data[key] or 0
end
return P
</string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="7">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="8">
      <Properties>
        <string name="Name">UniverseMiner</string>
      </Properties>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Commerce</string>
          <string name="Source">local Marketplace = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local C = require(game.ReplicatedStorage.UniverseMiner.Config)
local Economy = require(game.ReplicatedStorage.UniverseMiner.Economy)
local Data = require(script.Parent.Data)
local Game = require(script.Parent.Game)
local Commerce = { Catalog = { Passes = {}, Products = {} } }
local products = {}
local passIds = {}
for key, product in pairs(C.Products) do
	if product.Id &gt; 0 then
		assert(not products[product.Id], "Developer Product ID duplicado")
		products[product.Id] = product
	end
end
for key, id in pairs(C.Passes) do
	if id &gt; 0 then
		assert(not passIds[id], "Gamepass ID duplicado")
		passIds[id] = key
	end
end
function Commerce.loadCatalog()
	for key, id in pairs(C.Passes) do
		local card = { Configured = id &gt; 0, Price = nil, ForSale = nil }
		Commerce.Catalog.Passes[key] = card
		if id &gt; 0 then
			local ok, info = pcall(function()
				return Marketplace:GetProductInfoAsync(id, Enum.InfoType.GamePass)
			end)
			if ok then
				card.Price = info.PriceInRobux
				card.ForSale = info.IsForSale
			end
		end
	end
	for key, p in pairs(C.Products) do
		local card = { Configured = p.Id &gt; 0, Price = nil, ForSale = nil }
		Commerce.Catalog.Products[key] = card
		if p.Id &gt; 0 then
			local ok, info = pcall(function()
				return Marketplace:GetProductInfoAsync(p.Id, Enum.InfoType.Product)
			end)
			if ok then
				card.Price = info.PriceInRobux
				card.ForSale = info.IsForSale
			end
		end
	end
end
function Commerce.refresh(player)
	local s = Data.Sessions[player]
	if not s then
		return
	end
	for key, id in pairs(C.Passes) do
		if id &gt; 0 then
			local ok, owned = pcall(function()
				return Marketplace:UserOwnsGamePassAsync(player.UserId, id)
			end)
			if ok and Data.Sessions[player] == s then
				s.Data.Passes[key] = owned
			else
				warn("Gamepass não verificado:", key)
			end
		end
	end
	if Data.Sessions[player] ~= s or s.Closing then
		return
	end
	if s.Data.Passes.ExclusivePets and not s.Data.ExclusiveGranted then
		Game.pet(s.Data, "vip")
		s.Data.ExclusiveGranted = true
	end
	Game.snapshot(player)
end
function Commerce.prompt(player, arg)
	if type(arg) ~= "table" or type(arg.Key) ~= "string" then
		return
	end
	if arg.Type == "Pass" then
		local id = C.Passes[arg.Key]
		if id and id &gt; 0 and not Data.Sessions[player].Data.Passes[arg.Key] then
			Marketplace:PromptGamePassPurchase(player, id)
		else
			Game.notice(player, "Gamepass ainda não configurado.")
		end
	elseif arg.Type == "Product" then
		local p = C.Products[arg.Key]
		if p and p.Id &gt; 0 then
			Marketplace:PromptProductPurchase(player, p.Id)
		else
			Game.notice(player, "Produto ainda não configurado.")
		end
	end
end
function Commerce.init()
	task.spawn(Commerce.loadCatalog)
	Marketplace.PromptGamePassPurchaseFinished:Connect(function(player, _, purchased)
		if purchased then
			task.spawn(Commerce.refresh, player)
		end
	end)
	Marketplace.ProcessReceipt = function(receipt)
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		local s = player and Data.Sessions[player]
		if not s or not Data.writable(player) or s.Temporary then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local product = products[receipt.ProductId]
		if not product then
			warn("Recibo de produto sem configuração:", receipt.ProductId)
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		local d = s.Data
		local receiptKey = tostring(receipt.PurchaseId)
		-- Grant without yielding; record in the SAME durable profile. Retry always saves
		-- before acknowledgement, including an earlier in-memory grant whose save failed.
		local valid = Economy.receipt(d, receiptKey, product, os.time(), Game.pet, C.MaxNumber)
		if not valid then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		if not Data.save(player, false) then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		Game.snapshot(player)
		Game.notice(player, "Compra entregue e salva!")
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
end
return Commerce
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Content</string>
          <string name="Source">local C = require(game.ReplicatedStorage.UniverseMiner.Config)
local P = require(game.ReplicatedStorage.UniverseMiner.Progression)
local B = require(game.ReplicatedStorage.UniverseMiner.Balance)
local Data = require(script.Parent.Data)
local Content = {}
local Game
function Content.init(api)
	Game = api
end
function Content.join(player)
	local d = Data.Sessions[player].Data
	if not d.WelcomeGranted then
		d.WelcomeGranted = true
		Game.pet(d, "starter")
	end
	local rt = Game.Runtime[player]
	rt.JoinedAt = os.clock()
	rt.Gifts = {}
end
function Content.view(player)
	local d = Data.Sessions[player].Data
	local rt = Game.Runtime[player]
	local tutorial = C.Tutorial[d.Tutorial]
	return {
		Tutorial = d.Tutorial,
		TutorialProgress = tutorial and P.value(d, tutorial.Key) or 0,
		Upgrades = d.Upgrades,
		Login = d.Login,
		CanLogin = d.Login.LastDay ~= math.floor(os.time() / 86400),
		Achievements = d.Achievements,
		Discoveries = d.Discoveries,
		DiscoveryClaims = d.DiscoveryClaims,
		Hatched = d.Hatched,
		BossWins = d.BossWins,
		PlaySeconds = math.floor(os.clock() - rt.JoinedAt),
		PlayClaimed = rt.Gifts,
		Capacity = P.capacity(d, C.BaseBackpack),
		Combo = rt.Combo or 0,
		ComboEnds = rt.ComboEnds or 0,
	}
end
local function celebration(player, message)
	Game.emit(player, "Celebration", { Kind = "Level", Text = message })
end
function Content.action(player, key, arg)
	local d = Data.Sessions[player].Data
	local rt = Game.Runtime[player]
	if key == "Tutorial" then
		local goal = C.Tutorial[d.Tutorial]
		if not goal or P.value(d, goal.Key) &lt; goal.Target then
			return true
		end
		d.Tutorial += 1
		Game.gems(d, goal.Gems, false)
		celebration(player, "Objetivo concluído! +" .. goal.Gems .. " Gems")
	elseif key == "LoginGift" then
		local day = math.floor(os.time() / 86400)
		local streak = P.streak(d.Login.LastDay, d.Login.Streak, day)
		if not streak then
			return true
		end
		if streak == 7 and #d.Pets &gt;= C.MaxPets then
			Game.notice(player, "Libere espaço para seu Aurora Guardian.")
			return true
		end
		d.Login = { LastDay = day, Streak = streak }
		local gems = 25 * streak
		Game.gems(d, gems, false)
		d.EggCredits += streak &gt;= 3 and 2 or 1
		if streak == 7 then
			Game.pet(d, "streak")
		end
		celebration(player, "Presente do dia " .. streak .. " • +" .. gems .. " Gems e créditos de ovo")
	elseif key == "PlayGift" then
		if type(arg) ~= "number" or not C.PlayGifts[arg] then
			return true
		end
		local gift = C.PlayGifts[arg]
		if rt.Gifts[tostring(arg)] or os.clock() - rt.JoinedAt &lt; gift.Seconds then
			return true
		end
		rt.Gifts[tostring(arg)] = true
		Game.gems(d, gift.Gems, false)
		d.EggCredits += gift.Credits
		celebration(player, "Presente de exploração • +" .. gift.Gems .. " Gems")
	elseif key == "Upgrade" then
		if type(arg) ~= "string" or not C.GemUpgrades[arg] then
			return true
		end
		local spec = C.GemUpgrades[arg]
		local level = d.Upgrades[arg]
		if level &gt;= spec.Max then
			Game.notice(player, "Upgrade no nível máximo.")
			return true
		end
		local price = P.upgradeCost(spec, level)
		if d.Gems &lt; price then
			Game.notice(player, "Precisa de " .. B.compact(price) .. " Gems.")
			return true
		end
		d.Gems -= price
		d.Upgrades[arg] += 1
		celebration(player, spec.Name .. " • nível " .. d.Upgrades[arg])
	elseif key == "Achievement" then
		if type(arg) ~= "number" or not C.Achievements[arg] then
			return true
		end
		local spec = C.Achievements[arg]
		if d.Achievements[spec.Id] or P.value(d, spec.Key) &lt; spec.Target then
			return true
		end
		d.Achievements[spec.Id] = true
		Game.gems(d, spec.Gems, false)
		celebration(player, spec.Name .. " • +" .. spec.Gems .. " Gems")
	elseif key == "Discovery" then
		if type(arg) ~= "string" or not C.Pets[arg] or not d.Discoveries[arg] or d.DiscoveryClaims[arg] then
			return true
		end
		d.DiscoveryClaims[arg] = true
		local gems = C.Pets[arg].Rank * 5
		Game.gems(d, gems, false)
		Game.notice(player, "Descoberta registrada • +" .. gems .. " Gems")
	elseif key == "Fuse" then
		if type(arg) ~= "string" or #arg &gt; 40 then
			return true
		end
		local plan = P.fusion(d.Pets, d.Equipped, arg)
		if not plan then
			Game.notice(player, "Fusão precisa de 3 pets iguais e desequipados, da mesma variante.")
			return true
		end
		if d.Gems &lt; plan.Cost then
			Game.notice(player, "Fusão custa " .. plan.Cost .. " Gems.")
			return true
		end
		d.Gems -= plan.Cost
		for i = #d.Pets, 1, -1 do
			if table.find(plan.Ids, d.Pets[i].Uid) then
				table.remove(d.Pets, i)
			end
		end
		local pet = Game.pet(d, plan.PetId)
		pet.Tier = plan.Tier
		Game.emit(player, "Hatch", { pet })
	else
		return false
	end
	return true
end
return Content
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Data</string>
          <string name="Source">local DSS = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local Http = game:GetService("HttpService")
local C = require(game.ReplicatedStorage.UniverseMiner.Config)
local Data = { Sessions = {} }
local store = nil -- Acquire inside pcall: unpublished Studio places can reject this call.
local token = game.JobId .. ":" .. Http:GenerateGUID(false)
local LEASE = 240
local function copy(value)
	if type(value) ~= "table" then
		return value
	end
	local out = {}
	for k, v in pairs(value) do
		out[k] = copy(v)
	end
	return out
end
local function fresh()
	return {
		Version = 1,
		Upgrades = { Damage = 0, Coins = 0, Backpack = 0, Slots = 0 },
		Tutorial = 1,
		WelcomeGranted = false,
		Hatched = 0,
		Discoveries = {},
		DiscoveryClaims = {},
		Achievements = {},
		BossWins = 0,
		Login = { LastDay = -1, Streak = 0 },

		Coins = 0,
		Gems = 0,
		Rebirths = 0,
		Tool = 1,
		World = 1,
		Unlocked = { ["1"] = true },
		VisitedWorlds = { ["1"] = true },
		Pets = {},
		Equipped = {},
		Passes = {},
		Settings = { Music = true, Effects = true, ReducedMotion = false },
		Boosts = { Coins = 0, Luck = 0 },
		Bag = 0,
		BagCount = 0,
		ExclusiveGranted = false,
		EggCredits = 0,
		Crystals = 0,
		TotalCoins = 0,
		TotalPets = 0,
		Codes = {},
		Receipts = {},
		Daily = { Day = math.floor(os.time() / 86400), Crystals = 0, Coins = 0, Eggs = 0, Claimed = {} },
	}
end
local function normalize(raw)
	local d = fresh()
	if type(raw) ~= "table" then
		return d
	end
	if raw.Version and raw.Version ~= 1 then
		error("Versão de dados não suportada")
	end
	for k, v in pairs(d) do
		if type(raw[k]) == type(v) then
			d[k] = raw[k]
		end
	end
	for _, key in ipairs({
		"Coins",
		"Gems",
		"Rebirths",
		"Bag",
		"BagCount",
		"EggCredits",
		"Crystals",
		"TotalCoins",
		"TotalPets",
	}) do
		local n = d[key]
		d[key] = (n == n and n &gt;= 0 and n &lt; math.huge) and math.min(C.MaxNumber, n) or 0
	end
	d.Tool = math.clamp(math.floor(tonumber(d.Tool) or 1), 1, #C.Tools)
	d.World = math.clamp(math.floor(tonumber(d.World) or 1), 1, #C.Worlds)
	d.Unlocked["1"] = true
	for id, unlocked in pairs(d.Unlocked) do
		if unlocked then
			d.VisitedWorlds[id] = true
		end
	end
	local pets = {}
	for _, pet in ipairs(d.Pets) do
		if type(pet) == "table" and type(pet.Uid) == "string" and C.Pets[pet.Id] then
			table.insert(pets, pet)
		end
	end
	d.Pets = pets
	for key, u in pairs(C.GemUpgrades) do
		local value = tonumber(d.Upgrades[key]) or 0
		d.Upgrades[key] = (value == value and value &gt;= 0 and value &lt; math.huge)
				and math.clamp(math.floor(value), 0, u.Max)
			or 0
	end
	d.Tutorial = math.clamp(math.floor(d.Tutorial), 1, #C.Tutorial + 1)
	for _, p in ipairs(pets) do
		p.Tier = math.clamp(math.floor(tonumber(p.Tier) or 0), 0, 2)
		d.Discoveries[p.Id] = true
	end
	d.Passes = {} -- Ownership is verified with Marketplace on each login.
	return d
end
function Data.load(player)
	local loaded, blocked
	local ok, err = pcall(function()
		store = store or DSS:GetDataStore(C.DataStore)
		store:UpdateAsync("u:" .. player.UserId, function(old)
			blocked = false
			if old and old.Lock and old.Lock.Token ~= token and (old.Lock.Expires or 0) &gt; os.time() then
				blocked = true
				return nil
			end
			loaded = normalize(old and old.Data)
			return { Data = loaded, Lock = { Token = token, Expires = os.time() + LEASE } }
		end)
	end)
	if blocked then
		return nil, "Seus dados estão em outra sessão. Aguarde um minuto e tente novamente."
	end
	if not ok then
		warn("UniverseMiner load:", err)
		if RunService:IsStudio() and C.StudioTemporaryData then
			local s = { Data = fresh(), Temporary = true, Busy = false, LastSave = os.time() }
			Data.Sessions[player] = s
			return s
		end
		return nil, "Não foi possível carregar seus dados com segurança. Tente novamente."
	end
	local s = { Data = loaded, Temporary = false, Busy = false, LastSave = os.time() }
	Data.Sessions[player] = s
	return s
end
function Data.save(player, release)
	local s = Data.Sessions[player]
	if not s then
		return false
	end
	while s.Busy do
		task.wait(0.1)
	end
	if s.Temporary then
		return true
	end
	s.Busy = true
	local snapshot = copy(s.Data)
	local lost = false
	local ok, err = pcall(function()
		store:UpdateAsync("u:" .. player.UserId, function(old)
			if not old or not old.Lock or old.Lock.Token ~= token then
				lost = true
				return nil
			end
			return { Data = snapshot, Lock = not release and { Token = token, Expires = os.time() + LEASE } or nil }
		end)
	end)
	s.Busy = false
	if lost then
		s.ReadOnly = true
		player:Kick("A sessão de dados expirou. Entre novamente para proteger seu progresso.")
	end
	if not ok then
		warn("UniverseMiner save:", err)
	end
	if ok and not lost then
		s.LastSave = os.time()
		return true
	end
	return false
end
function Data.release(player)
	local s = Data.Sessions[player]
	if not s then
		return
	end
	s.Closing = true
	for attempt = 1, 3 do
		if Data.save(player, true) then
			break
		end
		task.wait(attempt)
	end
	Data.Sessions[player] = nil
end
function Data.writable(player)
	local s = Data.Sessions[player]
	return s and not s.ReadOnly and not s.Closing and (s.Temporary or os.time() - s.LastSave &lt; LEASE - 40)
end
return Data
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Game</string>
          <string name="Source">local Http = game:GetService("HttpService")
local Messaging = game:GetService("MessagingService")
local C = require(game.ReplicatedStorage.UniverseMiner.Config)
local B = require(game.ReplicatedStorage.UniverseMiner.Balance)
local P = require(game.ReplicatedStorage.UniverseMiner.Progression)
local Content = require(script.Parent.Content)
local Economy = require(game.ReplicatedStorage.UniverseMiner.Economy)
local Data = require(script.Parent.Data)
local Map = require(script.Parent.Map)
local Game = { Runtime = {} }
local rng = Random.new()
local outbound
function Game.init(remote)
	outbound = remote
	Content.init(Game)
end
function Game.emit(player, kind, payload)
	outbound:FireClient(player, kind, payload)
end
function Game.notice(player, text)
	Game.emit(player, "Notice", text)
end
function Game.event()
	local now = os.time()
	local cycle = math.floor(now / C.EventPeriod)
	local elapsed = now % C.EventPeriod
	local names = { "Coins", "Luck", "Gems", "Exclusive" }
	return {
		Kind = names[cycle % 4 + 1],
		Active = elapsed &lt; C.EventDuration,
		Ends = cycle * C.EventPeriod + C.EventDuration,
		Next = (cycle + 1) * C.EventPeriod,
	}
end
local function clamp(n)
	return math.min(C.MaxNumber, math.max(0, n))
end
function Game.daily(d)
	local day = math.floor(os.time() / 86400)
	if d.Daily.Day ~= day then
		d.Daily = { Day = day, Crystals = 0, Coins = 0, Eggs = 0, Claimed = {} }
	end
end
function Game.mult(d, kind)
	local value = 1
	for _, uid in ipairs(d.Equipped) do
		for _, pet in ipairs(d.Pets) do
			if pet.Uid == uid then
				value += (C.Pets[pet.Id][kind] or 0) * P.variant(pet.Tier)
				break
			end
		end
	end
	if kind == "Coins" or kind == "Damage" then
		value *= B.rebirthMultiplier(d.Rebirths)
	end
	if kind == "Damage" then
		value *= 1 + (d.Upgrades.Damage or 0) * 0.1
	end
	if kind == "Coins" then
		value *= C.Tools[d.Tool].Coins * (1 + (d.Upgrades.Coins or 0) * 0.08)
	end
	if d.Passes["Double" .. kind] then
		value *= 2
	end
	if (d.Boosts[kind] or 0) &gt; os.time() then
		value *= 2
	end
	local e = Game.event()
	if e.Active and e.Kind == kind then
		value *= 2
	end
	return value
end
function Game.snapshot(player, forceInventory)
	local s = Data.Sessions[player]
	if not s then
		return
	end
	Game.daily(s.Data)
	local d = s.Data
	local view = {}
	for _, key in ipairs({
		"Coins",
		"Gems",
		"Rebirths",
		"Tool",
		"World",
		"Unlocked",
		"VisitedWorlds",
		"Pets",
		"Equipped",
		"Passes",
		"Settings",
		"Boosts",
		"Bag",
		"BagCount",
		"EggCredits",
		"Crystals",
		"TotalCoins",
		"TotalPets",
		"Daily",
	}) do
		view[key] = d[key]
	end
	local ids = {}
	for _, pet in ipairs(d.Pets) do
		table.insert(ids, pet.Uid .. ":" .. (pet.Tier or 0))
	end
	local signature = table.concat(ids, ",") .. "|" .. table.concat(d.Equipped, ",")
	local rt = Game.Runtime[player]
	if rt and rt.InventorySignature == signature and not forceInventory then
		view.Pets = nil
		view.Equipped = nil
	elseif rt then
		rt.InventorySignature = signature
	end
	view.Store = Game.Store and Game.Store() or { Passes = {}, Products = {} }
	view.Content = Content.view(player)
	view.LuckMultiplier = Game.mult(d, "Luck")
	view.Temporary = s.Temporary
	view.Event = Game.event()
	view.CoinMultiplier = Game.mult(d, "Coins")
	view.DamageMultiplier = Game.mult(d, "Damage")
	view.RebirthCost = B.rebirthCost(d.Rebirths)
	view.Level = B.level(d.Crystals)
	view.AutoMine = Game.Runtime[player] and Game.Runtime[player].AutoMine or false
	Game.emit(player, "State", view)
end
function Game.gems(d, amount, boosted)
	d.Gems = clamp(d.Gems + math.floor(amount * (boosted and Game.mult(d, "Gems") or 1)))
end
function Game.coins(d, amount)
	amount = math.floor(amount)
	d.Coins = clamp(d.Coins + amount)
	d.TotalCoins = clamp(d.TotalCoins + amount)
	Game.daily(d)
	d.Daily.Coins = clamp(d.Daily.Coins + amount)
end
function Game.pet(d, id)
	local pet = { Uid = Http:GenerateGUID(false), Id = id }
	table.insert(d.Pets, pet)
	d.TotalPets += 1
	d.Discoveries[id] = true
	if #d.Equipped &lt; B.petSlots(d) then
		table.insert(d.Equipped, pet.Uid)
	end
	return pet
end
function Game.sell(player)
	local d = Data.Sessions[player].Data
	if d.Bag &lt;= 0 then
		return
	end
	local value = d.Bag
	d.Bag = 0
	d.BagCount = 0
	Game.coins(d, value)
	Game.emit(player, "Reward", { Coins = value, Text = "Mochila vendida!" })
end
function Game.mine(player, id)
	if not Data.writable(player) then
		return
	end
	local s = Data.Sessions[player]
	local d = s.Data
	local rt = Game.Runtime[player]
	local c = Map.Crystals[id]
	if not c or c.Health &lt;= 0 or c.World ~= d.World then
		return
	end
	local radius = d.Passes.Magnet and 55 or 24
	if not Map.near(player, c.Part.Position, radius) then
		return
	end
	local now = os.clock()
	local tool = C.Tools[d.Tool]
	if now - rt.LastHit &lt; tool.Interval then
		return
	end
	if not c.Boss and (d.BagCount or 0) &gt;= P.capacity(d, C.BaseBackpack) and not d.Passes.InfiniteBackpack then
		if d.Passes.AutoSell then
			Game.sell(player)
		else
			if now - rt.LastBagNotice &gt; 3 then
				Game.notice(player, "Mochila cheia: use SELL ou o botão Vender.")
				rt.LastBagNotice = now
			end
			return
		end
	end
	rt.LastHit = now
	local damage = tool.Damage * Game.mult(d, "Damage")
	if c.Boss then
		c.Contributors = c.Contributors or {}
		c.Contributors[player] = (c.Contributors[player] or 0) + math.min(c.Health, damage)
	end
	local destroyed = Map.hit(c, damage)
	Game.emit(player, "MineFX", { Position = c.Part.Position, Destroyed = destroyed })
	if destroyed then
		if c.Boss then
			for contributor, total in pairs(c.Contributors or {}) do
				if Data.writable(contributor) and total &gt; 0 then
					local profile = Data.Sessions[contributor].Data
					local share = math.clamp(total / c.MaxHealth, 0, 1)
					local coins = math.floor(C.Worlds[c.World].Reward * 100 * share * Game.mult(profile, "Coins"))
					Game.coins(profile, coins)
					Game.gems(profile, math.max(5, math.floor(100 * share)), true)
					profile.BossWins += 1
					Game.emit(
						contributor,
						"Celebration",
						{ Kind = "Rebirth", Text = "Titã derrotado! +" .. B.compact(coins) .. " Coins + Gems" }
					)
					Game.snapshot(contributor)
				end
			end
			return
		end
		if now &gt; (rt.ComboEnds or 0) then
			rt.Combo = 0
		end
		rt.Combo = math.min(C.ComboMax, (rt.Combo or 0) + 1)
		rt.ComboEnds = now + C.ComboWindow
		local level = B.level(d.Crystals)
		d.Crystals += 1
		Game.daily(d)
		d.Daily.Crystals += 1
		local reward =
			math.floor(C.Worlds[c.World].Reward * (c.Rare and 8 or 1) * Game.mult(d, "Coins") * P.combo(rt.Combo))
		d.Bag = clamp(d.Bag + reward)
		d.BagCount = (d.BagCount or 0) + 1
		Game.emit(player, "Reward", { Coins = reward, Text = "+" .. B.compact(reward) .. " na mochila" })
		if d.Passes.AutoSell then
			Game.sell(player)
		end
		if B.level(d.Crystals) &gt; level then
			Game.gems(d, 5, true)
			Game.emit(
				player,
				"Celebration",
				{ Kind = "Level", Text = "Nível " .. B.level(d.Crystals) .. " • +5 Gems" }
			)
		end
		local event = Game.event()
		if event.Active then
			Game.gems(d, 1, true)
			if event.Kind == "Exclusive" and #d.Pets &lt; C.MaxPets and rng:NextNumber() &lt; 0.002 then
				Game.pet(d, "event")
				Game.emit(player, "Hatch", { { Id = "event" } })
			end
		end
	end
end
local function rarity(d)
	return Economy.rarity(C.Weights, Game.mult(d, "Luck"), rng:NextNumber())
end
function Game.hatch(player, count)
	local d = Data.Sessions[player].Data
	local rt = Game.Runtime[player]
	if count ~= 1 and count ~= 3 then
		return
	end
	if count == 3 and not d.Passes.TripleHatch then
		return Game.notice(player, "Triple Hatch necessário.")
	end
	local now = os.clock()
	local interval = d.Passes.FastHatch and 1 or 3
	if now - rt.LastHatch &lt; interval then
		return
	end
	if not Map.near(player, Map.Eggs[d.World].Position, 20) then
		return Game.notice(player, "Aproxime-se do ovo do seu mundo.")
	end
	local plan, reason = Economy.hatchPlan(C.Worlds[d.World].EggCost, d.Coins, d.EggCredits, count, #d.Pets, C.MaxPets)
	if not plan then
		return Game.notice(
			player,
			reason == "Capacity" and "Inventário cheio: libere espaço em Pets." or "Coins insuficientes."
		)
	end
	rt.LastHatch = now
	d.Coins -= plan.Cost
	d.EggCredits -= plan.Credits
	local results = {}
	for _ = 1, count do
		local rank = rarity(d)
		local id = "w" .. d.World .. "r" .. rank
		local p = Game.pet(d, id)
		table.insert(results, p)
		if rank &gt;= 6 then
			local msg = player.DisplayName .. " encontrou " .. C.Pets[id].Name .. " (" .. C.Pets[id].Rarity .. ")!"
			outbound:FireAllClients("Global", msg)
			task.spawn(function()
				pcall(function()
					Messaging:PublishAsync("UM_Rare_v1", { Job = game.JobId, Text = msg })
				end)
			end)
		end
	end
	Game.daily(d)
	d.Daily.Eggs += count
	d.Hatched += count
	Game.emit(player, "Hatch", results)
	return nil
end
function Game.rebirth(player)
	local d = Data.Sessions[player].Data
	local cost = B.rebirthCost(d.Rebirths)
	if d.Coins &lt; cost then
		return Game.notice(player, "Você precisa de " .. B.compact(cost) .. " Coins.")
	end
	d.Coins = 0
	d.Bag = 0
	d.BagCount = 0
	d.Tool = 1
	d.Unlocked = { ["1"] = true }
	d.World = 1
	d.Rebirths += 1
	Game.gems(d, 50 + math.min(d.Rebirths, 10000) * 10, true)
	Map.teleport(player, 1)
	Game.emit(
		player,
		"Celebration",
		{ Kind = "Rebirth", Text = "REBIRTH! Multiplicador permanente " .. B.rebirthMultiplier(d.Rebirths) .. "x" }
	)
	return nil
end
function Game.action(player, action, arg)
	if not Data.writable(player) then
		return
	end
	local d = Data.Sessions[player].Data
	local rt = Game.Runtime[player]
	if action == "Mine" then
		if type(arg) == "number" and arg == arg then
			Game.mine(player, arg)
		end
		return
	end
	if action == "Sync" then
		Game.snapshot(player, true)
		return
	end
	if action == "Sell" then
		Game.sell(player)
	elseif action == "Tool" then
		local nextTool = C.Tools[d.Tool + 1]
		if nextTool and d.Coins &gt;= nextTool.Cost then
			d.Coins -= nextTool.Cost
			d.Tool += 1
			Game.emit(player, "Celebration", { Kind = "Level", Text = nextTool.Name })
		else
			Game.notice(player, "Coins insuficientes ou ferramenta máxima.")
		end
	elseif action == "World" then
		if type(arg) ~= "number" or arg % 1 ~= 0 or not C.Worlds[arg] then
			return
		end
		local w = C.Worlds[arg]
		if not d.Unlocked[tostring(arg)] then
			if d.Rebirths &lt; w.RequiredRebirths then
				return Game.notice(player, "Requer " .. w.RequiredRebirths .. " rebirths.")
			end
			if not d.Passes.TeleportAllWorlds then
				if arg &gt; 1 and not d.Unlocked[tostring(arg - 1)] then
					return Game.notice(player, "Desbloqueie o mundo anterior.")
				end
				if d.Coins &lt; w.Cost then
					return Game.notice(player, "Coins insuficientes.")
				end
				d.Coins -= w.Cost
			end
			d.Unlocked[tostring(arg)] = true
		end
		d.World = arg
		d.VisitedWorlds[tostring(arg)] = true
		Map.teleport(player, arg)
	elseif action == "Hatch" then
		Game.hatch(player, arg)
	elseif action == "Rebirth" then
		Game.rebirth(player)
	elseif action == "AutoMine" then
		if d.Passes.AutoMine then
			rt.AutoMine = not rt.AutoMine
		else
			Game.notice(player, "Auto Mine necessário.")
		end
	elseif action == "Equip" or action == "DeletePet" then
		if type(arg) ~= "string" or #arg &gt; 40 then
			return
		end
		for index, pet in ipairs(d.Pets) do
			if pet.Uid == arg then
				local equipped = table.find(d.Equipped, arg)
				if action == "DeletePet" then
					if equipped then
						return Game.notice(player, "Desequipe antes de excluir.")
					end
					table.remove(d.Pets, index)
				elseif equipped then
					table.remove(d.Equipped, equipped)
				elseif #d.Equipped &lt; B.petSlots(d) then
					table.insert(d.Equipped, arg)
				else
					Game.notice(player, "Slots de pets cheios.")
				end
				break
			end
		end
	elseif action == "EquipBest" then
		local pets = table.clone(d.Pets)
		table.sort(pets, function(a, b)
			return (C.Pets[a.Id].Coins + C.Pets[a.Id].Damage) * P.variant(a.Tier)
				&gt; (C.Pets[b.Id].Coins + C.Pets[b.Id].Damage) * P.variant(b.Tier)
		end)
		d.Equipped = {}
		for i = 1, math.min(#pets, B.petSlots(d)) do
			table.insert(d.Equipped, pets[i].Uid)
		end
	elseif action == "Quest" then
		if type(arg) ~= "number" or not C.Quests[arg] then
			return
		end
		Game.daily(d)
		local q = C.Quests[arg]
		if d.Daily.Claimed[tostring(arg)] or (d.Daily[q.Key] or 0) &lt; q.Target then
			return
		end
		if q.Reward == "daily" and #d.Pets &gt;= C.MaxPets then
			return Game.notice(player, "Libere espaço em Pets.")
		end
		d.Daily.Claimed[tostring(arg)] = true
		Game.gems(d, q.Gems, true)
		if q.Reward == "daily" then
			Game.pet(d, "daily")
		else
			d.Boosts[q.Reward] = math.max(os.time(), d.Boosts[q.Reward] or 0) + 900
		end
		Game.notice(player, "Missão concluída! Gems e recompensa entregues.")
	elseif action == "Code" then
		if type(arg) ~= "string" or #arg &gt; 40 then
			return
		end
		arg = string.upper(arg)
		local code = C.Codes[arg]
		if code and not d.Codes[arg] then
			d.Codes[arg] = true
			Game.gems(d, code.Gems, false)
			Game.notice(player, "Código resgatado!")
		else
			Game.notice(player, "Código inválido ou já resgatado.")
		end
	elseif Content.action(player, action, arg) then
	elseif action == "Setting" then
		if arg == "Music" or arg == "Effects" or arg == "ReducedMotion" then
			d.Settings[arg] = not d.Settings[arg]
		end
	end
	Game.snapshot(player)
	return nil
end
function Game.join(player)
	Game.Runtime[player] = {
		LastHit = -10,
		LastHatch = -10,
		LastBagNotice = -10,
		AutoMine = false,
		LastAFK = os.clock(),
		Tokens = 35,
		TokenAt = os.clock(),
	}
	local s = Data.Sessions[player]
	s.Data.BagCount = s.Data.BagCount or 0
	Content.join(player)
end
function Game.rate(player)
	local rt = Game.Runtime[player]
	if not rt then
		return false
	end
	local now = os.clock()
	rt.Tokens = math.min(35, rt.Tokens + (now - rt.TokenAt) * 20)
	rt.TokenAt = now
	if rt.Tokens &lt; 1 then
		return false
	end
	rt.Tokens -= 1
	return true
end
function Game.tick()
	Map.step()
	for player, rt in pairs(Game.Runtime) do
		if Data.writable(player) then
			local d = Data.Sessions[player].Data
			if os.clock() &gt; (rt.ComboEnds or 0) then
				rt.Combo = 0
			end
			if rt.AutoMine and d.Passes.AutoMine then
				local nearest, dist = nil, math.huge
				for id, c in pairs(Map.Crystals) do
					if
						c.World == d.World
						and c.Health &gt; 0
						and Map.near(player, c.Part.Position, d.Passes.Magnet and 55 or 24)
					then
						local root = player.Character.HumanoidRootPart
						local distance = (root.Position - c.Part.Position).Magnitude
						if distance &lt; dist then
							nearest = id
							dist = distance
						end
					end
				end
				if nearest then
					Game.mine(player, nearest)
				end
			end
			if d.Passes.AutoSell and d.Bag &gt; 0 then
				Game.sell(player)
			end
			if Map.near(player, Map.Sell[d.World].Position, 12) then
				Game.sell(player)
			end
			if os.clock() - rt.LastAFK &gt;= 30 then
				rt.LastAFK = os.clock()
				for _, zone in ipairs(Map.AFK) do
					if Map.near(player, zone.Part.Position, 12) and (not zone.VIP or d.Passes.VIP) then
						local mult = (zone.VIP and 3 or 1) * (d.Passes.PremiumAFK and 2 or 1)
						local coins = math.floor(20 * mult * Game.mult(d, "Coins"))
						Game.coins(d, coins)
						Game.gems(d, mult, true)
						Game.emit(player, "Reward", { Coins = coins, Text = "AFK • +" .. coins .. " Coins" })
						break
					end
				end
			end
		end
	end
end
function Game.subscribe()
	task.spawn(function()
		local ok, err = pcall(function()
			Messaging:SubscribeAsync("UM_Rare_v1", function(message)
				local payload = message.Data
				if type(payload) == "table" and payload.Job ~= game.JobId and type(payload.Text) == "string" then
					outbound:FireAllClients("Global", payload.Text)
				end
			end)
		end)
		if not ok then
			warn("Anúncios entre servidores indisponíveis:", err)
		end
	end)
end
return Game
